# ============================================================
# PsychAgent .gitignore
# 原则：源码、文档、品牌资产、构建与部署文件入库；
# 运行时数据、模型、缓存、日志、密钥、IDE/同步文件不入库。
#
# 明确保留（不要加入忽略规则）：
#   Dockerfile
#   docker-compose.yml
#   .dockerignore
#   requirements.txt
#   *.bat
# ============================================================

# ---------- Python 虚拟环境 / 编译缓存 ----------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
build/
dist_python/
develop-eggs/
downloads/
eggs/
parts/
sdist/
var/
.installed.cfg
*.egg

# ---------- 日志 / 临时文件 / 测试产物 ----------
logs/
*.log
*.trace
*.tmp
*.bak
*.orig
*.rej
*.pid
tmp/
temp/
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
test_output/
dump/
backup/

# ---------- 前端依赖与构建产物 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
*.tsbuildinfo
web/dist/
web/.dist-backup/
web/.dist-fonts-backup/
.vite/

# ---------- 本地运行时数据（知识库/记忆/数据库/索引） ----------
data/
store/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.pkl
Daily_thoughts/
Weekly_thoughts/
vector_store/
bm25_index/
embedding_cache/
.ipynb_checkpoints/

# ---------- 本地模型 ----------
models/
*.gguf
*.bin
model_cache/

# ---------- IDE / 系统 / 同步工具 ----------
.idea/
.vs/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
Desktop.ini
.DS_Store
._*
.claude/
.cursor/
.stfolder/
.stignore

# ---------- 本地配置 / 密钥 ----------
config/model_store.json
config/local_config.json
config/id_map.json
*.secret
.env
.env.local
.env.prod
api_key.txt
secret.key

# ---------- 设计 / 评测中间产物 ----------
.creative-design/
docs/_shots/
docs/_rag_tmp/
guide_eval/out*/
RAG/
