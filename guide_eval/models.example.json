{
  "note": "复制为 guide_eval/models.json 后填入你的 key 环境变量（key 仍从 .env 读，不写进本文件）。roles: candidate=被评测的咨询模型；judge=判定模型；simulator=用户模拟器（建议与 candidate 不同家，减少自偏好）。",
  "models": [
    {
      "name": "deepseek-chat",
      "provider": "openai",
      "model": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.3,
      "max_tokens": 900,
      "roles": ["candidate"]
    },
    {
      "name": "qwen-plus",
      "provider": "openai",
      "model": "qwen-plus",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "QWEN_API_KEY",
      "temperature": 0.3,
      "max_tokens": 900,
      "roles": ["candidate"]
    },
    {
      "name": "kimi-k2",
      "provider": "openai",
      "model": "kimi-k2-0905-preview",
      "base_url": "https://api.moonshot.cn/v1",
      "api_key_env": "MOONSHOT_API_KEY",
      "temperature": 0.3,
      "max_tokens": 900,
      "roles": ["candidate"]
    },
    {
      "name": "glm-4.5",
      "provider": "openai",
      "model": "glm-4.5",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key_env": "ZHIPU_API_KEY",
      "temperature": 0.3,
      "max_tokens": 900,
      "roles": ["candidate"]
    },
    {
      "name": "gpt-4.1-mini",
      "provider": "openai",
      "model": "gpt-4.1-mini",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.3,
      "max_tokens": 900,
      "roles": ["candidate"]
    },
    {
      "name": "judge-deepseek",
      "provider": "openai",
      "model": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.0,
      "max_tokens": 2000,
      "json_mode": true,
      "roles": ["judge"]
    },
    {
      "name": "sim-deepseek",
      "provider": "openai",
      "model": "deepseek-chat",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.8,
      "max_tokens": 400,
      "roles": ["simulator"]
    }
  ],
  "defaults": {
    "candidate": ["deepseek-chat", "qwen-plus", "kimi-k2", "glm-4.5"],
    "judge": ["judge-deepseek"],
    "simulator": ["sim-deepseek"]
  }
}
