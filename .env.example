# 复制本文件为 .env 后填写真实值：copy .env.example .env
# 注意：.env 已被 gitignore，绝不会进入版本库。

# ============ DeepSeek（默认对话/路由模型） ============
# 申请地址：https://platform.deepseek.com → API Keys → 创建
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ 通义千问 DashScope（可选） ============
# 申请地址：https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/v1

# ============ HuggingFace Token（可选，拉取受限模型时需要） ============
# 申请地址：https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxx